# Scheduler Agent — environment variables
# Copy to .env and fill in values: cp .env.example .env

# Required for agent loop
ANTHROPIC_API_KEY=

# Google Calendar (production only — dev uses in-memory calendar)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Per-user refresh tokens stored in your secrets store / DB — not in .env

# Slack HITL (production)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=@U0123456

# Shared infrastructure
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler

# Dev alternative — SQLite prefs (no Postgres required)
SCHEDULER_PREFS_DB=./data/preferences.db

# Webhook server (Process B)
WEBHOOK_PORT=3000

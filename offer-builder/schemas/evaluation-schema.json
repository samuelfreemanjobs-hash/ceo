{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-schema.json",
  "title": "OfferBuilderEvaluation",
  "description": "Legacy alias for evaluator-result-schema.json. Prefer evaluator-result-schema.json for new integrations.",
  "type": "object",
  "required": ["scores", "final_status", "iteration_count"],
  "properties": {
    "scores": {
      "type": "object",
      "required": [
        "completeness",
        "consistency",
        "policy",
        "grounding",
        "tone",
        "differentiation"
      ],
      "properties": {
        "completeness": { "type": "integer", "minimum": 0, "maximum": 3 },
        "consistency": { "type": "integer", "minimum": 0, "maximum": 3 },
        "policy": { "type": "integer", "minimum": 0, "maximum": 3 },
        "grounding": { "type": "integer", "minimum": 0, "maximum": 3 },
        "tone": { "type": "integer", "minimum": 0, "maximum": 3 },
        "differentiation": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "final_status": {
      "type": "string",
      "enum": ["pass", "revise", "escalate_human"]
    },
    "iteration_count": { "type": "integer", "minimum": 1, "maximum": 3 },
    "revisions_requested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "current_score",
          "target_score",
          "specific_issues",
          "recommended_owner_agent"
        ],
        "properties": {
          "dimension": { "type": "string" },
          "current_score": { "type": "integer", "minimum": 0, "maximum": 3 },
          "target_score": { "type": "integer", "const": 2 },
          "specific_issues": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommended_owner_agent": {
            "type": "string",
            "enum": [
              "discovery",
              "solution_architect",
              "pricing",
              "risk",
              "copywriter",
              "director"
            ]
          }
        }
      }
    },
    "diff_summary": { "type": "string" }
  }
}

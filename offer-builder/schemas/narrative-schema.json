{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example.com/schemas/narrative-schema.json",
  "title": "Narrative",
  "description": "Copywriter Agent output block. Director maps into offer.narrative.",
  "type": "object",
  "required": ["executive_summary", "value_proposition", "why_us", "next_steps", "style_applied"],
  "properties": {
    "executive_summary": { "$ref": "#/$defs/narrativeBlock" },
    "value_proposition": { "$ref": "#/$defs/narrativeBlock" },
    "why_us": { "$ref": "#/$defs/narrativeBlock" },
    "objection_handling": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objection", "response", "trigger"],
        "properties": {
          "objection": { "type": "string" },
          "response": { "type": "string" },
          "trigger": { "type": "string" }
        }
      }
    },
    "next_steps": {
      "type": "object",
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action", "owner", "by_date"],
            "properties": {
              "action": { "type": "string" },
              "owner": { "type": "string" },
              "by_date": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "style_applied": {
      "type": "object",
      "required": ["segment", "style"],
      "properties": {
        "segment": { "enum": ["enterprise", "mid-market", "SMB"] },
        "style": { "enum": ["formal", "consultative", "technical", "founder-direct"] }
      }
    },
    "flags_back_to_solution_architect": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "narrativeBlock": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "claim_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sentence_index", "source"],
            "properties": {
              "sentence_index": { "type": "integer", "minimum": 0 },
              "source": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

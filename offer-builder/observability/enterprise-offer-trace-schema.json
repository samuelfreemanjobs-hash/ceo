{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnterpriseOfferTrace",
  "description": "Distributed trace for one commercial offer build (Offer Director parent span)",
  "type": "object",
  "required": ["trace_id", "offer_id", "opportunity_id", "agent", "parent_trace_id"],
  "properties": {
    "trace_id": { "type": "string" },
    "parent_trace_id": { "type": ["string", "null"] },
    "offer_id": { "type": "string" },
    "opportunity_id": { "type": "string" },
    "agent": {
      "type": "string",
      "enum": [
        "offer-director",
        "offer-discovery",
        "solution-architect",
        "offer-pricing",
        "offer-risk-compliance",
        "offer-copywriter",
        "offer-evaluator"
      ]
    },
    "system_prompt_version": { "type": "string" },
    "skill_versions": { "type": "object" },
    "tools_called": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "args_hash", "result_status"],
        "properties": {
          "name": { "type": "string" },
          "args_hash": { "type": "string" },
          "result_status": { "type": "string", "enum": ["ok", "error", "blocked"] },
          "latency_ms": { "type": "integer" }
        }
      }
    },
    "tokens_in": { "type": "integer" },
    "tokens_out": { "type": "integer" },
    "latency_ms": { "type": "integer" },
    "decision_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "rule": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "evaluator_iteration": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
    "outcome_linked": {
      "type": "object",
      "properties": {
        "crm_opportunity_id": { "type": "string" },
        "closed_won": { "type": ["boolean", "null"] },
        "revenue": { "type": ["number", "null"] }
      }
    }
  }
}

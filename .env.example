# Environment variables (copy to .env — never commit .env)

# GitHub (Actions use GITHUB_TOKEN automatically)
# GITHUB_TOKEN=ghp_...

# Slack (optional — CEO triage / approvals)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CEO_CHANNEL_ID=C...

# Notion (optional)
# NOTION_API_KEY=secret_...

# Supabase (optional — if linked project)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# Firecrawl (optional — Casey research)
# FIRECRAWL_API_KEY=fc-...

# Zapier MCP — authenticate via Cursor MCP settings, not env

# Analytics export path override (optional)
# ANALYTICS_CSV_PATH=data/analytics/campaign-weekly.csv

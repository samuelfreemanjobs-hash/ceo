# CEO Business Stack — environment overview
# Copy per-package examples:
#   cp marketing-dept/.env.example marketing-dept/.env
#   cp scheduler-agent/.env.example scheduler-agent/.env

# Minimum to run marketing Phase 1:
ANTHROPIC_API_KEY=

# Minimum to run scheduler dev smoke:
# ANTHROPIC_API_KEY (same as above)

# Production scheduler adds:
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET
# SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, REDIS_URL, DATABASE_URL

# Start local infra:
#   docker compose up -d
